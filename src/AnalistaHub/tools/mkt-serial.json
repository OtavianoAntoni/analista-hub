{
  "id": "mkt-serial",
  "name": "Consulta SN",
  "category": "MikroTik",
  "description": "Consulta o Serial Number da RB no inventário e devolve SN+1.",
  "longDescription": "Lê o IP de uma RB MikroTik (digitado ou copiado para a área de transferência), autentica no inventário e devolve o serial cadastrado com o sufixo \"1\".",
  "icon": "material:router",
  "script": "mkt_serial.ps1",
  "interpreter": "powershell",
  "modeArgs": [ "-Mode", "hub" ],
  "inputs": [
    {
      "key": "ip",
      "label": "IP da RB",
      "arg": "-Ip",
      "type": "ip",
      "ping": true,
      "required": false,
      "emptyUsesClipboard": true,
      "placeholder": "10.0.0.1",
      "hint": "aceita CIDR /32",
      "example": "10.0.0.1"
    }
  ],
  "output": {
    "default": "clipboard",
    "allowed": [ "clipboard", "type", "notify" ],
    "valueLabel": "serial da RB com o sufixo \"1\"",
    "successLabel": "0 significa: IP não cadastrado no inventário.",
    "hideTitle": true,
    "highlightSuffix": "1",
    "zeroValue": {
      "title": "SEM SN",
      "note": "Não registrado"
    }
  },
  "credentials": {
    "label": "Inventário",
    "fields": [
      {
        "key": "user",
        "label": "Usuário",
        "env": "ANALISTAHUB_USER",
        "secret": false,
        "placeholder": "e-mail ou usuário de acesso"
      },
      {
        "key": "passwd",
        "label": "Senha",
        "env": "ANALISTAHUB_PASS",
        "secret": true,
        "placeholder": "senha do inventário"
      }
    ],
    "legacyFile": "${CFG:mkt-serial.cofre}",
    "validation": {
      "url": "${CFG:mkt-serial.url}",
      "method": "POST",
      "contentType": "application/json",
      "bodyTemplate": "{\"type\":\"auth\",\"email\":\"{user}\",\"passw\":\"{passwd}\"}",
      "okJsonPath": "st",
      "okEquals": "true",
      "messagePath": "msg",
      "timeoutSeconds": 8
    }
  },
  "network": {
    "label": "Inventário (HTTP)",
    "host": "${CFG:mkt-serial.host}",
    "port": 3113
  },
  "timeoutSeconds": 14,
  "logFile": "%TEMP%/mkt_serial.log",
  "examples": [ "10.0.0.1", "10.0.0.1/32" ],
  "notes": "Token JWT fica em cache por 45 min ao lado do script. Com o token vencido o script refaz o login e repete a consulta uma vez, sozinho."
}
