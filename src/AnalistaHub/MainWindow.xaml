<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnalistaHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource HubPageBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- barra lateral -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="20,18,20,10" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource HubAccentBrush}">
                        <FontIcon Glyph="&#xE8A7;" FontSize="15" Foreground="#FF10131C"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Analista Hub" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Ferramentas do analista" Style="{StaticResource HubSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <ListView x:Name="NavList" Grid.Row="1" Margin="8,4,8,4" SelectionMode="Single"
                      SelectionChanged="OnNavSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding IconVisual}" Width="22" Height="22"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" FontSize="14"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Padding="16,8,16,16" Spacing="8">
                <Button Content="Buscar ferramenta…" Click="OnOpenHudClick" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="HotkeyHint" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="HotkeyWarning" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="#FFFF9F9F" />
                <!-- a janela não tem X (o fechar pelo título destrói a janela e o WinUI abre as
                     seguintes em branco); sair é por aqui ou pelo menu do ícone -->
                <Grid ColumnSpacing="8" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Minimizar" Click="OnMinimizeClick" HorizontalAlignment="Stretch" FontSize="12" />
                    <Button Grid.Column="1" Content="Fechar" Click="OnExitClick" HorizontalAlignment="Stretch" FontSize="12" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- conteúdo -->
        <ScrollViewer Grid.Column="1" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Padding="30,24,30,30" Spacing="14" />
        </ScrollViewer>
    </Grid>
</Window>
