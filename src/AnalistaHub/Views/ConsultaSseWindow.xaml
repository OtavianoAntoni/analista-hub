<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnalistaHub.Views.ConsultaSseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{StaticResource HubHudBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- cabeçalho -->
        <Grid Grid.Row="0" Padding="18,14,18,2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" FontSize="16" VerticalAlignment="Center"
                      Foreground="{StaticResource HubAccentBrush}" />
            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="Consulta SSE" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Cidade → Sigla Anatel · NM · OLT · VPN" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="HeaderInfo" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- busca -->
        <Grid Grid.Row="1" Padding="18,12,18,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                     FontSize="19" PlaceholderText="Cidade, sigla Anatel ou UF…" />
        </Grid>

        <!-- resultados -->
        <Grid Grid.Row="2" Margin="8,0,8,4">
            <ListView x:Name="ResultsList" SelectionMode="Single" IsItemClickEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,9,14,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                        Background="#1AFFFFFF" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Uf}" FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border Grid.Column="2" CornerRadius="6" Padding="9,4"
                                        Background="{StaticResource HubAccentBrush}" VerticalAlignment="Center">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="SIGLA ANATEL" FontSize="7" FontWeight="SemiBold"
                                                   Foreground="#99000000" />
                                        <TextBlock Text="{Binding Sigla}" FontFamily="Consolas" FontSize="12.5"
                                                   FontWeight="Bold" Foreground="#0D1117" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" Margin="0,7,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.65*" />
                                                <ColumnDefinition Width="1.35*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="NM" FontSize="7.5"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Nm}" Style="{StaticResource HubMono}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="OLT" FontSize="7.5"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Olt}" Style="{StaticResource HubMono}"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="VPN" FontSize="7.5"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Vpn}" Style="{StaticResource HubMono}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- rodapé -->
        <Grid Grid.Row="3" Padding="18,6,18,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock x:Name="StatusText" FontSize="11.5"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SourceText" FontSize="10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" FontSize="10.5" VerticalAlignment="Center"
                       Text="↑↓ navegar · Enter copiar · Esc fechar"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
