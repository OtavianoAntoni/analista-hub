<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnalistaHub.Views.ToastHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource HubHudBackground}" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- cabeçalho -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="HeaderIcon" Glyph="&#xE73E;" FontSize="14" Margin="0,0,8,0"
                      VerticalAlignment="Center" Foreground="{StaticResource HubAccentBrush}" />
            <TextBlock x:Name="HeaderText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Padding="6,2" BorderThickness="0" Background="Transparent" Click="OnCloseClick" />
        </Grid>

        <!-- valor -->
        <TextBlock x:Name="ValueText" Grid.Row="1" Margin="0,6,0,0" FontFamily="Consolas" FontSize="26"
                   FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   Foreground="{ThemeResource HubMonoValue}" />

        <!-- subtítulo / aviso -->
        <TextBlock x:Name="SubtitleText" Grid.Row="2" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- ping do destino (NET-001): últimos retornos ICMP do IP consultado -->
        <TextBlock x:Name="PingText" Grid.Row="3" Margin="0,4,0,0" FontSize="11" Opacity="0.75"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- rodapé -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="ContextText" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="TimerText" FontSize="10"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="CopyButton" Content="Copiar" Click="OnCopyClick" FontSize="12" Padding="10,4" />
                <Button x:Name="PinButton" Content="Manter aberto" Click="OnPinClick" FontSize="12" Padding="10,4" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
