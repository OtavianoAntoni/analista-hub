<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AnalistaHub.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Identidade visual do HUB (escuro, discreto, legível) -->
            <Color x:Key="HubAccentColor">#FF3FA7D6</Color>
            <SolidColorBrush x:Key="HubAccentBrush" Color="{StaticResource HubAccentColor}" />
            <SolidColorBrush x:Key="HubHudBackground" Color="#F21B1D26" />
            <SolidColorBrush x:Key="HubCardBackground" Color="#FF23252F" />
            <SolidColorBrush x:Key="HubStroke" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="HubMonoValue" Color="#FF9CE8FF" />

            <Style x:Key="HubMono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="HubTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="HubSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
